# Supabase 프로젝트 설정 > API 에서 확인. Vercel 프로젝트의 Environment Variables에도 동일하게 등록하세요.

# 브라우저에 노출되는 값 (anon/public key만 사용)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_public_key

# 서버(API route)에서만 사용, 절대 브라우저로 노출되면 안 됨
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key

# 경비실이 입력한 경고 메시지를 음성으로 변환하는 데 사용 (Google AI Studio:
# https://aistudio.google.com/apikey 에서 발급한 Gemini API 키. Google Cloud TTS와는
# 다른 키/제품이니 혼동하지 말 것)
GEMINI_API_KEY=여기에_gemini_api_key
